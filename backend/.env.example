ENVIRONMENT=production
PROJECT_NAME="Data Forge API"
VERSION="0.1.0"
DEBUG=false

# Groq AI Configuration (Backend Only)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Supabase Authentication & Storage (Backend Only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
SUPABASE_AUDIENCE=authenticated

# Host & Database Configuration
HOST=0.0.0.0
PORT=8000
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres

# Storage & File Limits
MAX_UPLOAD_SIZE_MB=25

# Production CORS Origins (JSON list format)
CORS_ORIGINS=["https://your-dataforge-frontend.vercel.app","http://localhost:5173"]
