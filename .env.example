# Data Forge Root Environment Variables Template

# Environment mode: development | production | testing
ENVIRONMENT=production
PROJECT_NAME=Data Forge

# Groq API Configuration (Backend Only)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Supabase Authentication & Database (Backend Only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres

# Backend Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS Settings (Production frontend URL)
CORS_ORIGINS=https://your-dataforge-frontend.vercel.app,http://localhost:5173

# Frontend Settings (Public client environment variables)
VITE_API_BASE_URL=https://your-dataforge-backend.onrender.com/api/v1
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
